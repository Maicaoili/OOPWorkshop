<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.inventory_system.controller.TransactionsController">
    <padding>
        <Insets top="18" right="18" bottom="18" left="18" />
    </padding>
    <children>
        <Button text="← Back to Dashboard" onAction="#handleDashboardReturn" style="-fx-background-color: transparent; -fx-text-fill: #2980b9; -fx-cursor: hand; -fx-padding: 0 0 10 0;" />
        <Label text="Stock Transactions Log" style="-fx-font-size: 22px; -fx-font-weight: bold;" />

        <HBox spacing="12" alignment="CENTER_LEFT">
            <children>
                <Label text="Filter:" />
                <ComboBox fx:id="typeFilter" prefWidth="120" />
                <Button text="Refresh" onAction="#handleRefresh" />
                <HBox HBox.hgrow="ALWAYS" />
                <Button text="Add Transaction" onAction="#handleAdd" style="-fx-background-color: #27ae60; -fx-text-fill: white;" />
            </children>
        </HBox>

        <TableView fx:id="transactionsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="60" />
                <TableColumn fx:id="itemColumn" text="Item" prefWidth="250" />
                <TableColumn fx:id="typeColumn" text="Type" prefWidth="80" />
                <TableColumn fx:id="qtyColumn" text="Quantity" prefWidth="80" />
                <TableColumn fx:id="notesColumn" text="Notes" prefWidth="300" />
                <TableColumn fx:id="dateColumn" text="Date" prefWidth="150" />
            </columns>
        </TableView>

        <!-- Inline Form for Add -->
        <VBox fx:id="formPanel" spacing="12" style="-fx-border-color: #bdc3c7; -fx-border-radius: 4; -fx-padding: 16;" managed="false" visible="false">
            <Label text="Record New Transaction" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
            <HBox spacing="12">
                <VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Item" /><ComboBox fx:id="formItem" maxWidth="1.7976931348623157E308" /></VBox>
                <VBox spacing="4"><Label text="Type" /><ComboBox fx:id="formType" prefWidth="100" /></VBox>
                <VBox spacing="4"><Label text="Quantity" /><TextField fx:id="formQuantity" prefWidth="100" /></VBox>
            </HBox>
            <VBox spacing="4"><Label text="Notes" /><TextArea fx:id="formNotes" prefRowCount="2" /></VBox>
            <HBox spacing="8">
                <Button text="Record" onAction="#handleSave" style="-fx-background-color: #2980b9; -fx-text-fill: white;" />
                <Button text="Cancel" onAction="#handleCancel" />
            </HBox>
        </VBox>
    </children>
</VBox>
